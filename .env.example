# -----------------------------------------------------------------------------
# Housing4All Platform — environment variables
# Copy to .env.local (never commit .env.local). Values below are public-safe.
# -----------------------------------------------------------------------------

# Supabase (public, safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://jcrjzmflepnvvvneahvs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Efz2TV3dVzugDBPGxZCXxQ_mfjvs5Ue

# Optional: canonical site URL used for auth redirects. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=https://housing4all-platform.vercel.app

# Dev/test only: enables the email+password sign-in form used by Playwright.
# Hard-disabled when VERCEL_ENV=production regardless of this value.
# ENABLE_TEST_PASSWORD_LOGIN=true

# -----------------------------------------------------------------------------
# Local Supabase stack (pnpm db:start) — for e2e and RLS tests.
# `supabase status` prints these; the local keys are well-known dev defaults.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from `supabase status`>
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# Phase 2A — Deal Finder: forwarded alert emails (Resend inbound) + jobs.
# All optional. Unset ⇒ "Not connected" in Settings → Integrations; manual entry,
# CSV upload and "Paste an email" still work. Production values live in Vercel
# env only (setup steps: docs/ACCOUNTS.md). Never put real values in this file.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=               # reads received email bodies (Full access key)
# RESEND_WEBHOOK_SECRET=        # whsec_… signing secret of the email.received webhook
# INBOUND_EMAIL_DOMAIN=         # e.g. inbound.thehousing4all.com or <id>.resend.app
# INNGEST_EVENT_KEY=            # set by the Inngest Vercel integration; unset ⇒ jobs run inline
# INNGEST_SIGNING_KEY=          # set by the Inngest Vercel integration
# INNGEST_DEV=1                 # local only: use the Inngest dev server (npx inngest-cli@latest dev)
# Owner alert email — OFF in Phase 2A. Needs all three.
# H4A_ALERT_EMAILS=on
# ALERT_EMAIL_FROM=             # e.g. Housing4All Alerts <alerts@send.thehousing4all.com>

# -----------------------------------------------------------------------------
# Later phases (do NOT set yet) — secrets go in Vercel env / Supabase Vault only
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=            # Phase 2–3
